FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-value
DATABASE_URL=sqlite:///og_website_v2.db
APP_ENV=development

# Admin login. Generate the hash with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_EMAIL=admin@ogmultiservicesllc.com
ADMIN_PASSWORD_HASH=change-me-generate-a-real-hash

# Optional: where uploaded course videos/slides/audio are stored.
# Defaults to instance/course_media if unset.
# COURSE_MEDIA_DIR=/absolute/path/to/storage

# Required for the Civics Test module (OG Academy) — evaluates a student's
# spoken answer against the accepted answers for a question.
OPENAI_API_KEY=sk-your-key-here

# OG Payments (Square) — SANDBOX ONLY until docs/SQUARE_PRODUCTION_ACTIVATION.md has been followed.
# SQUARE_APPLICATION_ID and SQUARE_LOCATION_ID are safe to reach the browser (Square's own Web Payments
# SDK needs them to render the card form) — SQUARE_ACCESS_TOKEN and SQUARE_WEBHOOK_SIGNATURE_KEY are
# server secrets and must NEVER be committed or sent to the frontend.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=sandbox-sq0idb-your-app-id
SQUARE_ACCESS_TOKEN=EAAAl-your-sandbox-access-token
SQUARE_LOCATION_ID=your-sandbox-location-id
# The exact URL Square calls for webhooks (must match what's registered in the Square Developer Dashboard
# under Webhooks — used to verify the signature, not just to receive the call).
SQUARE_WEBHOOK_URL=https://your-domain.example.com/webhooks/square
SQUARE_WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key
# A second, explicit opt-in required (in ADDITION to SQUARE_ENVIRONMENT=production) before this app will
# ever place a live charge — see docs/SQUARE_PRODUCTION_ACTIVATION.md. Leave unset/0 until that's done.
SQUARE_ALLOW_PRODUCTION=0

# Transactional Email (Titan/Bluehost SMTP) — see docs/TRANSACTIONAL_EMAIL_SETUP.md.
# MAIL_ENABLED must be explicitly "1" before ANY SMTP delivery is attempted — leave it unset/0 during
# local development so tests and browsing never send real mail. SMTP_PASSWORD is a secret: never commit it.
MAIL_ENABLED=0
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=info@ogmultiservicesllc.com
SMTP_PASSWORD=your-titan-mailbox-password
MAIL_FROM_EMAIL=info@ogmultiservicesllc.com
MAIL_FROM_NAME=OG Multiservices LLC
MAIL_REPLY_TO=info@ogmultiservicesllc.com
# The real production HTTPS origin (no trailing slash) — used to build every link inside an email.
# Never leave this as localhost in production; validate_for_production() refuses to start if it is.
APP_PUBLIC_URL=http://localhost:5001
# Optional local-dev safety net: when set (and APP_ENV is not "production"), every outgoing email's real
# delivery address is redirected here instead of the actual customer — the EmailLog still shows who it
# was really meant for. Leave unset in production.
MAIL_DEV_REDIRECT_TO=
