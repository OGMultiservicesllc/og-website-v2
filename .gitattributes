# Normalize to LF in the repo regardless of the checkout OS — the deploy target
# (the VPS) is Linux, and mixed line endings make diffs noisy.
* text=auto eol=lf

# Binary/media types: never diff, never line-ending-convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.db binary
